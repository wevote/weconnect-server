// One session, stored on the browser as the WeConnectSession cookie, associated with a person, who will need to
// be authenticated to have any rights (except maybe newbies filling out a questionnaire)
model ClientSession {
  id                    Int      @id @default(autoincrement())
  personId              Int
  sessionID             String   @unique
  dateCreated           DateTime @default(now()) @updatedAt
  dateExpires           DateTime
  userAgent             String
}
